# Admin / host portal password (default in dev: pens-dev)
PENS_ADMIN_PASSWORD=pens-dev

# Optional: canonical public URL for QR codes / links (e.g. https://pens-eeg-game-cursor.vercel.app)
# NEXT_PUBLIC_SITE_URL=

# --- Live persistence (Upstash Redis) — recommended on Vercel for multi-instance live rooms ---
# When both URL + token are set, live sessions use Redis (no Firebase required).
# Vercel KV also works: use KV_REST_API_URL + KV_REST_API_TOKEN from the integration.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Live realtime (Firestore) — optional; only if NEXT_PUBLIC_LIVE_TRANSPORT=firestore ---
# Set NEXT_PUBLIC_LIVE_TRANSPORT=firestore and add the Firebase keys below.
# Deploy firestore.rules (see firebase.json). Host secrets stay server-only (pens_live_host).
# Leave unset for local in-memory rooms; set to "firestore" with Firebase env vars for production.
# NEXT_PUBLIC_LIVE_TRANSPORT=firestore
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Full service account JSON as a single line (Vercel / CI secret)
FIREBASE_SERVICE_ACCOUNT_JSON=
